# Crabcast web app (bare-metal install) — serves the static SPA build
# (web/dist) via web/serve.mjs. API_UPSTREAM must point at the API.
[Unit]
Description=Crabcast web app
Documentation=https://github.com/sonyarianto/crabcast
After=network-online.target crabcast-server.service
Wants=network-online.target

[Service]
Type=simple
User=crabcast
Group=crabcast
WorkingDirectory=/opt/crabcast/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=API_UPSTREAM=http://127.0.0.1:8080
ExecStart=/usr/bin/node /opt/crabcast/web/serve.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
